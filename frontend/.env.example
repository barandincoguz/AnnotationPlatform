# Frontend environment variables (all VITE_ prefix to be exposed at build time).
# Copy to .env.local for local overrides.

# Base URL for the API. Empty string in dev (Vite proxy handles routing).
# Production: same-origin (FastAPI serves SPA + API on one port).
VITE_API_BASE_URL=

# Backend target the Vite dev proxy forwards `/api/*` to. Defaults to
# http://127.0.0.1:8000 (matches `uvicorn` defaults). Override when the
# backend is on a different port — e.g. e2e tests run an isolated
# backend on :8001 and set `VITE_PROXY_TARGET=http://127.0.0.1:8001`.
# Read from vite.config.ts; ignored in production builds.
# VITE_PROXY_TARGET=http://127.0.0.1:8000
