# ---- Environment ----
# Valid values: development (default), test, production
# In production mode the following are enforced at startup:
#   * SESSION_SECRET must not be the default placeholder
#   * SESSION_SECRET must be at least 32 characters
#   * BOOTSTRAP_ADMIN_PASSWORD (if set) must be at least 12 characters
# Misconfigured production deploys fail fast with a single stderr block.
ENVIRONMENT=development

# ---- Data directory ----
# Defaults to <project>/data. Container mounts /data.
# DATA_DIR=/data

# ---- Session ----
# Generate a strong secret:  openssl rand -hex 32
SESSION_SECRET=dev-secret-DO-NOT-USE-IN-PROD
SESSION_COOKIE_NAME=anotasyon_session
# Browser cookie and server-side session lifetime use the same absolute limit.
SESSION_MAX_AGE_SECONDS=2592000
# Keep `lax` for normal same-origin deployments. Use `none` only when the
# application must run in a cross-site iframe; `none` always forces Secure.
SESSION_COOKIE_SAMESITE=lax

# ---- Bootstrap admin (first-run only) ----
# When the users table has zero active admins AND both vars below are set,
# the lifespan startup creates an admin user with these credentials.
#
# SECURITY: After the first successful seed, UNSET both vars from the
# environment (or remove them from .env.production) and rotate the
# password via the admin panel. Leaving creds in the deploy artifact is
# the single most common takeover vector for self-hosted apps.
#
# Choose values that pass production enforcement:
#   - username: 3-32 chars
#   - password: ≥12 chars in production; pick something un-guessable
#     (do NOT use "admin", "password", or the username repeated)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- CSRF / Origin allowlist ----
# Comma-separated list of full origins (scheme + host + optional port)
# that the production OriginCheckMiddleware will accept for state-changing
# POST/PUT/PATCH/DELETE requests. Browser cookies alone do NOT defend
# against CSRF; this allowlist does. Required in production.
#
# Example for a single deploy:
#   ALLOWED_ORIGINS=https://anotasyon.example.com
# Multiple origins (rare; e.g. staging + prod sharing a backend):
#   ALLOWED_ORIGINS=https://anotasyon.example.com,https://staging.example.com
ALLOWED_ORIGINS=

# ---- Reverse-proxy trust ----
# Set to "1" only when the app sits behind a trusted reverse proxy
# (Caddy / nginx / Cloudflare). Off by default; trusting an
# attacker-controlled X-Forwarded-For lets clients forge audit IPs.
# TRUST_FORWARDED_FOR=0
# Required in production when trust is enabled. List only the immediate
# proxy network(s), never 0.0.0.0/0 or ::/0. The proxy must overwrite or
# append X-Forwarded-For on every request.
# TRUSTED_PROXY_CIDRS=172.18.0.0/16

# ---- Backup (optional, GitHub remote) ----
# When set, the backup loop pushes a compressed JSON snapshot of the DB to a
# GitHub repo every 24 hours by default. PAT must have contents:write only.
#
# Snapshots exclude `user_sessions` (session tokens are bearer creds
# and must never land in a repo). bcrypt password hashes in `users`
# are still present — store the backup repo as PRIVATE and treat its
# read access as equivalent to "everyone can attempt offline password
# cracking against bcrypt(rounds=12)".
BACKUP_REPO_URL=https://github.com/barandincoguz/PrivateAnnotationDatas.git
GITHUB_PAT=

# ---- Tests / dev ----
# Set to 1 inside test runs to disable the SPA static mount that would
# fail when backend/static/ does not exist.
# DISABLE_SPA_MOUNT=1

# ---- Phase 4: Neon dual-write mirror (optional) ----
# Partner Neon Postgres connection string for the async dispatcher. When
# unset (default) the app boots in "Neon unreachable" degraded mode — the
# _outbox queue still grows and the dispatcher keeps retrying connect, but
# nothing is shipped until this env var is populated. Use a read-write role
# (NOT the read-only role from the one-time import); scope: CREATE + INSERT
# + UPDATE + DELETE on baran_* tables.
# NEON_MIRROR_URL=postgresql://baran_rw:...@ep-...neon.tech/neondb?sslmode=require
#
# Batch size for each drain pass (default 100). Tune only if Neon write
# throughput becomes a bottleneck.
# NEON_MIRROR_BATCH_SIZE=100

# Prediction ingest (Mac-side `dqcheck predict-agent` → this instance).
# Generate with: openssl rand -hex 32
# Empty → /api/internal/predictions* answer 503 and the audit degrades to
# "model kontrolü yapılamadı" without blocking any annotator.
DQCHECK_INGEST_TOKEN=
